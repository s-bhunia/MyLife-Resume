{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@mylife/*": [
        "../../packages/*/src/index.ts",
        "../../packages/*/src/index.tsx"
      ]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/bookshelf" },
    { "path": "../../packages/loader" },
    { "path": "../../packages/tube-clock" },
    { "path": "../../packages/globe" },
    { "path": "../../packages/book-slider" },
    { "path": "../../packages/scroll" },
    { "path": "../../packages/chatbot" },
    { "path": "../../packages/core-engine" }
  ]
}
