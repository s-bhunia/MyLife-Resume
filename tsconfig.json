{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@mylife/*": [
        "packages/*/index.ts",
        "packages/*/index.tsx",
        "packages/*.tsx"
      ]
    }
  },
  "include": ["apps/landingpage/src", "packages"],
  "references": [
    {
      "path": "./packages/bookshelf"
    },
    {
      "path": "./packages/loader"
    },
    {
      "path": "./packages/tube-clock"
    },
    {
      "path": "./packages/globe"
    },
    {
      "path": "./packages/book-slider"
    },
    {
      "path": "./packages/scroll"
    }
  ]
}
